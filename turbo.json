{
  "globalEnv": [
    "VITE_PARLAY_API_URL",
    "VITE_OPTIONS_API_URL",
    "VITE_SOLANA_NETWORK"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "clean": {
      "cache": false
    }
  }
}
