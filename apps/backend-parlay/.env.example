# ============================================================================
# PARLAY BACKEND ENVIRONMENT VARIABLES
# ============================================================================

PORT=3001

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/parlay-tokens

# Solana Configuration
BACKEND_WALLET_PUBLIC_KEY=<your-public-key>
BACKEND_WALLET_PRIVATE_KEY=<your-private-key-array>
SOLANA_RPC_URL=https://api.devnet.solana.com

# Jupiter API
JUPITER_API_KEYS=<your-jupiter-api-key>

# Environment
NODE_ENV=development
